    userinfopage.h \
    biometriccollectionpage.h \
    facecapturepage.h \
    fingerprintcapturepage.h \
    passwordsetuppage.h \
    registrationcompletepage.h \
    networkmanager.h \
    virtualkeyboard.h \
    qt5keyboard/include/CandidateBar.h \
    qt5keyboard/include/FuzzyPinyinMatcher.h \
    qt5keyboard/include/KeyButton.h \
    qt5keyboard/include/LayoutManager.h \
    qt5keyboard/include/PinyinEngine.h \
    qt5keyboard/include/SentenceInputProcessor.h \
    qt5keyboard/include/SmartCandidateBar.h \
    qt5keyboard/include/SmartLearningSystem.h \
    qt5keyboard/include/SmartPinyinEngine.h \
